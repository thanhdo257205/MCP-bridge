{
  "allowed_workspaces": ["C:/absolute/path/to/approved-project"],
  "executable": "agy",
  "extra_env_passthrough": [],
  "prompt_transport": "argv",
  "max_timeout_seconds": 900,
  "default_timeout_seconds": 300,
  "max_output_bytes": 262144,
  "max_retained_tasks": 50,
  "max_queued_tasks": 3,
  "max_parallel_worktrees": 2,
  "default_autonomy": "auto",
  "worktree_setup": [
    {"workspace": "C:/absolute/path/to/approved-project", "commands": [["npm", "ci", "--no-audit", "--no-fund"]], "timeout_seconds": 300}
  ],
  "agents": {
    "priority": ["antigravity", "codex", "opencode", "claude"],
    "enabled": ["antigravity", "codex", "opencode", "claude", "codex-work", "codex-backup", "opencode-work", "claude-work"],
    "codex_sandbox": "workspace-write",
    "codex_ask_for_approval": "on-request",
    "opencode_executable": "opencode",
    "opencode_model": "opencode/big-pickle",
    "claude_executable": "claude",
    "claude_permission_mode": "acceptEdits",
    "profiles": {
      "codex-work": {
        "adapter": "codex",
        "label": "Codex (Work Account)",
        "env": {
          "CODEX_HOME": "C:/Users/name/.codex-work"
        }
      },
      "codex-backup": {
        "adapter": "codex",
        "label": "Codex (Backup Account)",
        "env": {
          "CODEX_HOME": "C:/Users/name/.codex-backup"
        }
      },
      "opencode-work": {
        "adapter": "opencode",
        "label": "OpenCode (Work)",
        "env": {
          "XDG_DATA_HOME": "C:/Users/name/.opencode-work/data",
          "XDG_CONFIG_HOME": "C:/Users/name/.opencode-work/config"
        },
        "model": "opencode/big-pickle"
      },
      "claude-work": {
        "adapter": "claude",
        "label": "Claude Code (Work Account)",
        "env": {
          "CLAUDE_CONFIG_DIR": "C:/Users/name/.claude-work"
        }
      }
    },
    "pools": {
      "codex-smart-pool": {
        "members": ["codex-work", "codex-backup"],
        "hard_task_profile": "codex-work",
        "quota_cooldown_seconds": 900
      }
    }
  },
  "xerj": {
    "enabled": false,
    "url": "http://127.0.0.1:9200",
    "default_index": "mcp-bridge-docs",
    "auto_reference": false,
    "max_passages": 3
  },
  "tree_watch": {
    "enabled": true,
    "delays_ms": [500, 1000, 2000, 4000, 10000]
  }
}
